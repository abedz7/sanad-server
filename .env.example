# ---- Runtime ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ---- Database ----
MONGODB_URI=mongodb://localhost:27017/sanad

# ---- Auth ----
# Generate with: openssl rand -base64 48   (must be at least 32 characters)
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Set to true behind HTTPS (marks the admin refresh cookie Secure)
COOKIE_SECURE=false

# ---- CORS: comma-separated exact origins allowed to call the API with credentials ----
CORS_ORIGINS=http://localhost:5173

# ---- Uploads ----
STORAGE_DRIVER=local            # local | s3
LOCAL_STORAGE_DIR=./storage     # gitignored; outside any static path
MAX_UPLOAD_BYTES=5242880        # 5 MB
# Only used when STORAGE_DRIVER=s3 (any S3-compatible endpoint, e.g. MinIO)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Business rules ----
REOPEN_WINDOW_DAYS=7

# ---- Seed (used only by `npm run seed`; never read by the running server) ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-me-with-a-strong-password
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=replace-me-with-a-strong-password
